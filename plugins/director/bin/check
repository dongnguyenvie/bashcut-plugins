#!/bin/sh
# Dependency probe: exits 0 and prints the Node.js that AI Editor will use (>= 22.19), or exits 1 with the reason.
here="$(cd "$(dirname "$0")" && pwd)"
if node="$("$here/find-node")"; then
    echo "Node.js $("$node" -v) at $node"
    exit 0
fi
echo "Node.js 22.19 or newer was not found (BashCut's shared or plugin data folder, Homebrew, nvm, Volta)." >&2
exit 1
