#!/usr/bin/env python3
"""Views Example: a BashCut plugin panel (plugin API 8) in one file, Python standard library only.

Read it top to bottom:
  1. Protocol   - the session transport: hello, requests, host calls (about 50 lines you can copy).
  2. Gallery    - the "Components" view: every component type, events and state.
  3. Voice      - the "Voice" view, a tab in the agent dock: reuse other plugins through BashCut (voice.speak,
                  plugins.invoke, media.import).
  4. Title card - a sheet: a short form that closes itself when done.
  5. Actions    - Tools buttons that call BashCut while they run, one opening the sheet.

Views are answers, not widgets: BashCut sends `view.render` (draw) or `view.event` (the user did something) and the
plugin answers with the whole component tree. Keep what you need between requests in `state`.
"""
import json
import math
import os
import struct
import sys
import time
import wave
import zlib

# ---------------------------------------------------------------------------------------------------- 1. Protocol


def send(message):
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


class Request:
    """One request from BashCut. `call` runs a BashCut command over the host channel and waits for its answer;
    `render` redraws the view while the request is still working."""

    calls = 0

    def __init__(self, message):
        self.id = message["id"]
        self.method = message["method"]
        self.params = message.get("params") or {}

    def call(self, method, params=None):
        Request.calls += 1
        call_id = f"call-{Request.calls}"
        send({"type": "call", "id": self.id, "callId": call_id, "method": method, "params": params or {}})
        for line in sys.stdin:
            reply = json.loads(line)
            if reply.get("type") == "callResult" and reply.get("callId") == call_id:
                if "error" in reply:
                    raise RuntimeError(reply["error"].get("message", "BashCut refused the call"))
                return reply.get("result")
            if reply.get("type") == "shutdown":
                sys.exit(0)
        sys.exit(0)

    def wait_job(self, started, timeout=600):
        """Commands that take long (voice.speak, plugins.invoke …) answer {"job": id}; poll jobs.status."""
        job = (started or {}).get("job")
        if not job:
            return started
        deadline = time.time() + timeout
        while time.time() < deadline:
            status = self.call("jobs.status", {"job": job})
            if status.get("state") == "completed":
                return status.get("result")
            if status.get("state") in ("failed", "cancelled"):
                raise RuntimeError(status.get("error") or status.get("state"))
            time.sleep(0.4)
        raise RuntimeError("timed out")

    def render(self, body, title=None):
        event = {"kind": "render", "body": body}
        if title:
            event["title"] = title
        send({"type": "event", "id": self.id, "event": event})

    def notify(self, text):
        send({"type": "event", "id": self.id, "event": {"kind": "notify", "text": text}})


def main():
    for line in sys.stdin:
        message = json.loads(line)
        kind = message.get("type")
        if kind == "hello":
            # The hello lists the host's features: check "views.<type>" before using a newer component.
            FEATURES.update(message.get("features") or [])
            send({"type": "hello", "apiVersion": 8})
        elif kind == "shutdown":
            break
        elif kind == "request":
            request = Request(message)
            try:
                send({"id": request.id, "result": handle(request)})
            except Exception as error:  # noqa: BLE001 - every failure goes back to BashCut as an error
                send({"id": request.id, "error": {"code": "failed", "message": str(error)}})


FEATURES = set()


def handle(request):
    params = request.params
    if request.method in ("view.render", "view.event"):
        view = VIEWS.get(params.get("view"))
        if not view:
            raise ValueError(f"unknown view {params.get('view')}")
        return view(request, params.get("state") or {}, params.get("values") or {}, params.get("event"))
    if request.method == "plugin.action":
        if params.get("action") == f"{PLUGIN_ID}.title-card":
            request.call("plugins.show-view", {"plugin": PLUGIN_ID, "view": "titleCard"})
            return {"message": "Opened the title card form"}
        return hello_action(request)
    raise ValueError(f"unknown method {request.method}")


def is_vietnamese(params):
    return str(params.get("locale", "")).startswith("vi")


# ----------------------------------------------------------------------------------------------------- 2. Gallery

SHOTS = [
    {"id": "s1", "title": "Opening wide", "subtitle": "Street, golden hour", "icon": "film", "badge": "0:04"},
    {"id": "s2", "title": "Coffee pour", "subtitle": "Close-up, slow motion", "icon": "cup.and.saucer", "badge": "0:02"},
    {"id": "s3", "title": "Interview", "subtitle": "Medium shot, two cameras", "icon": "person.2", "badge": "1:12"},
    {"id": "s4", "title": "Drone city", "subtitle": "Aerial, 4K", "icon": "airplane", "badge": "0:09"},
    {"id": "s5", "title": "Night market", "subtitle": "Handheld, low light", "icon": "moon.stars", "badge": "0:16"},
]


def gallery(request, state, values, event):
    """Every component. Events change `state`; the answer redraws the whole view."""
    count = state.get("count", 0)
    selected = state.get("selected")
    starred = set(state.get("starred", []))
    if event:
        node, kind, value = event.get("node"), event.get("type"), event.get("value")
        if node == "openSheet":
            # A plugin opens its own views where they live (panel, dock tab or sheet).
            request.call("plugins.show-view", {"plugin": PLUGIN_ID, "view": "titleCard"})
        elif node == "add":
            count += 1
        elif node == "reset":
            count = 0
        elif node == "shots" and kind == "select":
            selected = value
        elif node == "shots" and kind == "action":
            item = value.get("item")
            starred.symmetric_difference_update({item})
    query = str(values.get("query", "")).lower()
    shots = [dict(shot, badge=("★ " if shot["id"] in starred else "") + shot["badge"],
                  actions=[{"id": "star", "title": "Star", "icon": "star"}])
             for shot in SHOTS if query in shot["title"].lower() or query in shot["subtitle"].lower()]
    before, after = sample_images()
    speed = values.get("speed", 1.0)
    vi = is_vietnamese(request.params)
    context = request.params.get("context") or {}
    project = context.get("project") or {}
    return {
        "title": "Thành phần" if vi else "Components",
        "state": {"count": count, "selected": selected, "starred": sorted(starred)},
        "body": [
            {"type": "text", "text": "Every component a plugin view can use. The answer to each event is the whole "
                                     "view; BashCut draws it natively.", "style": "secondary"},
            {"type": "section", "title": "Text", "children": [
                {"type": "text", "text": "Title", "style": "title"},
                {"type": "text", "text": "**Markdown** _inline_ and `code`", "markdown": True},
                {"type": "text", "text": "Caption in orange", "style": "caption", "color": "orange"},
                {"type": "row", "children": [
                    {"type": "badge", "text": "NEW"}, {"type": "badge", "text": "OK", "color": "green"},
                    {"type": "badge", "text": "SLOW", "color": "red"},
                ]},
                {"type": "keyValue", "items": [
                    {"key": "Project", "value": str(project.get("name") or "—")},
                    {"key": "Playhead", "value": str(context.get("playhead", 0))},
                    {"key": "Greeting", "value": str((request.params.get("options") or {}).get("greeting", ""))},
                    {"key": "Host features", "value": str(len(FEATURES))},
                ]},
            ]},
            {"type": "section", "title": "Buttons and state", "children": [
                {"type": "text", "text": f"Clicked {count} times", "style": "heading"},
                {"type": "progress", "value": min(count / 10, 1), "label": f"{min(count, 10)} / 10"},
                {"type": "button", "id": "openSheet", "title": "Open the title card sheet", "icon": "macwindow"},
                {"type": "row", "children": [
                    {"type": "button", "id": "add", "title": "Add one", "icon": "plus", "style": "primary"},
                    {"type": "button", "id": "reset", "title": "Reset", "style": "destructive",
                     "confirm": "Reset the counter?", "disabled": count == 0},
                ]},
            ]},
            {"type": "section", "title": "Inputs", "children": [
                {"type": "textField", "id": "query", "label": "Search shots (live)", "placeholder": "coffee",
                 "search": True},
                {"type": "toggle", "id": "proxies", "label": "Use proxies"},
                {"type": "picker", "id": "ratio", "label": "Ratio", "value": values.get("ratio", "16:9"),
                 "options": ["16:9", "9:16", "1:1"]},
                {"type": "slider", "id": "speed", "label": "Speed", "min": 0.25, "max": 4, "step": 0.25},
                {"type": "textArea", "id": "notes", "label": "Notes (sent with the next event)", "height": 60},
                {"type": "text", "style": "mono",
                 "text": json.dumps({k: values.get(k) for k in ("proxies", "ratio", "speed", "notes")})},
                {"type": "text", "style": "caption", "text": f"Speed {speed}× · shots matching: {len(shots)}"},
            ]},
            {"type": "section", "title": "List", "children": [
                {"type": "list", "id": "shots", "items": shots, "selected": selected,
                 "empty": "No shot matches the search"},
                {"type": "text", "style": "caption", "text": f"Selected: {selected or 'none'} · starred: {len(starred)}"},
            ]},
            {"type": "section", "title": "Media", "collapsed": True, "children": [
                {"type": "image", "path": before, "height": 90, "caption": "image: a local file, shown as a thumbnail"},
                {"type": "imageCompare", "before": before, "after": after, "height": 120,
                 "beforeLabel": "Before", "afterLabel": "After"},
                {"type": "audio", "path": sample_tone(), "title": "Play a tone"},
            ]},
            {"type": "divider"},
            {"type": "hologram", "text": "A type this BashCut does not know draws a placeholder; the rest still works."},
        ],
    }


def cache_folder():
    folder = os.environ.get("BASHCUT_PLUGIN_CACHE") or os.path.join(os.path.expanduser("~"), ".cache", "views-example")
    os.makedirs(folder, exist_ok=True)
    return folder


def write_png(path, width, height, pixel):
    rows = b"".join(b"\x00" + b"".join(bytes(pixel(x, y)) for x in range(width)) for y in range(height))
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    with open(path, "wb") as handle:
        handle.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
                     + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))


def sample_images():
    """Two generated pictures: a flat grey "before" and a graded "after"."""
    before, after = os.path.join(cache_folder(), "before.png"), os.path.join(cache_folder(), "after.png")
    if not os.path.exists(after):
        write_png(before, 160, 90, lambda x, y: (90 + x // 4, 90 + x // 4, 90 + x // 4))
        write_png(after, 160, 90, lambda x, y: (min(255, 40 + x), 80 + y, max(0, 200 - x)))
    return before, after


def sample_tone():
    path = os.path.join(cache_folder(), "tone.wav")
    if not os.path.exists(path):
        with wave.open(path, "wb") as out:
            out.setnchannels(1)
            out.setsampwidth(2)
            out.setframerate(22050)
            out.writeframes(b"".join(struct.pack("<h", int(8000 * math.sin(2 * math.pi * 440 * i / 22050)))
                                     for i in range(22050 // 2)))
    return path


# ------------------------------------------------------------------------------------------------------- 3. Voice


def voice(request, state, values, event):
    """Reuse other plugins without knowing them:
    - voice.speak: BashCut picks the user's voice.synthesize plugin (VieNeu-TTS or any other);
    - plugins.invoke: a capability without its own command (audio.loudness, listed in "uses");
    - media.import: place the chosen take on the timeline, as an undoable edit by this plugin."""
    takes = state.get("takes", [])
    message = state.get("message", "")
    if event and event.get("node") == "speak":
        text = str(values.get("text") or "").strip()
        if not text:
            message = "Write something to say first."
        else:
            request.render([{"type": "progress", "label": "Generating takes with your voice plugin…"}])
            result = request.wait_job(request.call("voice.speak", {"text": text, "takes": 2, "keepTakes": True}))
            takes = [{"path": take["path"], "score": take.get("score"), "seconds": take.get("seconds")}
                     for take in result.get("takes", [])]
            message = f"{len(takes)} takes. Play them, measure them or use one."
    elif event and event.get("node") == "takes" and event.get("type") == "action":
        item, action = event["value"].get("item"), event["value"].get("action")
        take = next((t for t in takes if t["path"] == item), None)
        if take and action == "measure":
            measured = request.wait_job(request.call("plugins.invoke", {
                "capability": "audio.loudness", "params": {"mediaPath": take["path"]}}))
            loudness = (measured or {}).get("result", {})
            take["lufs"] = loudness.get("integratedLUFS")
            message = f"Measured with {measured.get('plugin')}: {take['lufs']:.1f} LUFS"
        elif take and action == "use":
            rev = request.call("context.get")["rev"]
            request.call("media.import", {"path": take["path"], "place": True, "baseRev": rev})
            request.notify("Take placed on the timeline")
            message = "Placed. Undo works like any edit."
    rows = [{
        "id": take["path"], "title": os.path.basename(take["path"]), "icon": "waveform", "audio": take["path"],
        "subtitle": " · ".join(filter(None, [
            f"{take['seconds']:.1f}s" if take.get("seconds") else "",
            f"score {take['score']:.2f}" if take.get("score") is not None else "",
            f"{take['lufs']:.1f} LUFS" if take.get("lufs") is not None else "",
        ])),
        "actions": [{"id": "measure", "title": "Measure loudness", "icon": "speedometer"},
                    {"id": "use", "title": "Use this take", "icon": "plus.rectangle.on.rectangle"}],
    } for take in takes]
    return {
        "title": "Giọng nói" if is_vietnamese(request.params) else "Voice",
        "state": {"takes": takes, "message": message},
        "body": [
            {"type": "textArea", "id": "text", "label": "Text", "height": 70},
            {"type": "button", "id": "speak", "title": "Generate takes", "icon": "waveform", "style": "primary",
             "wide": True},
            {"type": "text", "text": message, "style": "caption"} if message else {"type": "spacer", "size": 0},
            {"type": "list", "id": "takes", "items": rows, "empty": "No takes yet"},
        ],
    }


# --------------------------------------------------------------------------------------------------- 4. Title card


def title_card(request, state, values, event):
    """A sheet: a short form. Answer `"close": true` to close the sheet when the user is done."""
    node = (event or {}).get("node")
    if node == "cancel":
        return {"body": [], "close": True, "state": {}}
    if node == "create":
        title = str(values.get("title") or "").strip()
        if not title:
            return title_card_form(values, "Write a title first.")
        request.call("ui.notify", {"message": f"Title card: {title} ({values.get('style', 'bold')}, "
                                              f"{values.get('seconds', 3)} s)"})
        return {"body": [], "close": True, "state": {}, "notify": "Title card created"}
    return title_card_form(values, "")


def title_card_form(values, problem):
    return {
        "title": "New title card",
        "body": [
            {"type": "textField", "id": "title", "label": "Title", "placeholder": "Chapter 1", "submit": True},
            {"type": "textField", "id": "subtitle", "label": "Subtitle"},
            {"type": "picker", "id": "style", "label": "Style", "value": values.get("style", "bold"),
             "options": [{"value": "bold", "label": "Bold"}, {"value": "minimal", "label": "Minimal"},
                         {"value": "neon", "label": "Neon"}]},
            {"type": "slider", "id": "seconds", "label": "Seconds", "min": 1, "max": 10, "step": 0.5,
             "value": values.get("seconds", 3)},
            {"type": "text", "text": problem, "style": "caption", "color": "red"} if problem else {"type": "spacer", "size": 0},
            {"type": "row", "children": [
                {"type": "button", "id": "cancel", "title": "Cancel"},
                {"type": "spacer"},
                {"type": "button", "id": "create", "title": "Create", "style": "primary"},
            ]},
        ],
    }


VIEWS = {"gallery": gallery, "voice": voice, "titleCard": title_card}
PLUGIN_ID = "bashcut.views-example"

# ----------------------------------------------------------------------------------------------------- 5. Actions


def hello_action(request):
    """A Tools button: actions of session plugins (API 8) can call BashCut too."""
    greeting = (request.params.get("options") or {}).get("greeting") or "Hello"
    timeline = request.call("context.get")
    request.call("ui.notify", {"message": f"{greeting}! The project is at revision {timeline.get('rev')}."})
    return {"message": greeting}


if __name__ == "__main__":
    main()
