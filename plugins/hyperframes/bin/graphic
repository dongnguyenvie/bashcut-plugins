#!/bin/sh
# Render a composition and put it on the timeline in one call, and render it again when its data or the brand
# changes (see lib/graphic.mjs):
#   bin/graphic place D --at-frame F [--duration N] [--set key=value|key=@file …] [--variables JSON] [--frame JSON]
#                      [--steps-from voice|sections]
#   bin/graphic rerender ITEM|MEDIA|--all [--set key=value …] [--unset key] [--variables JSON] [--frame JSON] [--keep-length]
#                        [--draft|--final]
#   bin/graphic plan [--only g1,g2] [--draft|--final] | bin/graphic examples [NAME]
#   bin/graphic finalise  (every draft on the timeline at full quality: plan --final or rerender --all --final;
#                          BashCut runs it as the plugin's export step before a final export)
#   … --draft on plan, place or rerender: 15 fps, faster capture, for review; plan --final / rerender --all --final
#   renders the drafts at full quality before export
#   … --snapshot 1.5,4,9.2 [-o OUT] on plan, place or rerender ITEM: PNGs of the row as it would render, nothing placed
# Uses $BASHCUT_CLI when set, else `bashcut` on PATH. Prints one JSON line.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
if ! node="$("$here/find-node")"; then
    echo "Node.js 22.19+ is missing: choose Install Dependencies for HyperFrames Graphics in BashCut › Plugins." >&2
    exit 3
fi
exec "$node" "$here/../lib/graphic.mjs" "$@"
