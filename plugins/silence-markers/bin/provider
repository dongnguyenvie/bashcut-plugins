#!/usr/bin/env python3
"""Silence Markers: finds quiet stretches in the selected clip's audio and adds a section marker at each one.

BashCut plugin API 2, one-shot transport: `provider rpc` reads one request and writes one response.
Audio is decoded with macOS `afconvert` to 16 kHz mono PCM, then measured in 10 ms windows with the stdlib.
"""
import json
import math
import os
import struct
import subprocess
import sys
import tempfile
import uuid
import wave

WINDOW_SECONDS = 0.01
RATE = 16000


def fps(value, fallback=30.0):
    if isinstance(value, list) and len(value) == 2 and value[1]:
        return value[0] / value[1]
    if isinstance(value, (int, float)) and value > 0:
        return float(value)
    return fallback


def decode(path):
    """Mono 16-bit samples at RATE, decoded by afconvert into a temporary WAV."""
    handle, wav_path = tempfile.mkstemp(suffix=".wav", dir=os.environ.get("TMPDIR"))
    os.close(handle)
    try:
        subprocess.run(
            ["afconvert", "-f", "WAVE", "-d", f"LEI16@{RATE}", "-c", "1", path, wav_path],
            check=True, capture_output=True, timeout=110)
        with wave.open(wav_path, "rb") as audio:
            frames = audio.readframes(audio.getnframes())
        return struct.unpack(f"<{len(frames) // 2}h", frames)
    except subprocess.CalledProcessError as error:
        raise ValueError(f"cannot decode audio: {error.stderr.decode(errors='replace').strip() or error}")
    finally:
        os.remove(wav_path)


def silences(samples, start_s, end_s, threshold_db, min_seconds):
    """[(start, end)] in source seconds where the RMS level stays below threshold_db."""
    window = int(RATE * WINDOW_SECONDS)
    threshold = 32768 * 10 ** (threshold_db / 20)
    first, last = int(start_s * RATE), min(len(samples), int(end_s * RATE))
    found, quiet_from = [], None
    for offset in range(first, last, window):
        chunk = samples[offset:offset + window]
        rms = math.sqrt(sum(s * s for s in chunk) / len(chunk)) if chunk else 0
        now = offset / RATE
        if rms < threshold:
            quiet_from = now if quiet_from is None else quiet_from
        elif quiet_from is not None:
            if now - quiet_from >= min_seconds:
                found.append((quiet_from, now))
            quiet_from = None
    if quiet_from is not None and last / RATE - quiet_from >= min_seconds:
        found.append((quiet_from, last / RATE))
    return found


def mark(params):
    context, values, options = params["context"], params["params"], params.get("options", {})
    item, media = context.get("selection"), context.get("media")
    if not item or not media or not media.get("absolutePath"):
        raise ValueError("select a clip with media")
    project_fps = fps(context["project"].get("fps"))
    media_fps = fps(media.get("fps"), project_fps)
    speed = float(item.get("speed", 1) or 1)
    at, duration, source_in = int(item["at"]), int(item["dur"]), int(item.get("in", 0))
    start_s = source_in / media_fps
    end_s = start_s + duration / project_fps * speed
    ranges = silences(decode(media["absolutePath"]), start_s, end_s, values["thresholdDb"], values["minSilenceMs"] / 1000)

    def frame(seconds):
        return at + round((seconds - start_s) / speed * project_fps)

    prefix = options.get("labelPrefix") or "Silence"
    marks = [{"start": frame(a), "end": min(at + duration, frame(b)), "seconds": round(b - a, 2)} for a, b in ranges]
    operations = [
        {"op": "upsertSection", "id": str(uuid.uuid4()), "label": f'{prefix} {m["seconds"]:.1f}s', "atFrame": m["start"]}
        for m in marks
    ]
    if not operations:
        return {"message": "No silence found", "data": {"silences": []}}
    return {
        "label": "Mark silences", "baseRev": context["project"]["rev"], "operations": operations,
        "message": f"Marked {len(operations)} silences", "data": {"silences": marks},
        "pluginData": {"lastRun": {"item": item["id"], "count": len(marks), "thresholdDb": values["thresholdDb"]}},
        "ui": {"reveal": marks[0]["start"]},
    }


def handle(request):
    try:
        if request.get("method") != "plugin.action":
            return {"id": request["id"], "error": {"code": "unknown_method", "message": str(request.get("method"))}}
        if request["params"].get("action") != "bashcut.silence-markers.mark":
            raise ValueError("unknown action")
        return {"id": request["id"], "result": mark(request["params"])}
    except Exception as error:  # noqa: BLE001 - every failure goes back to BashCut
        return {"id": request["id"], "error": {"code": "failed", "message": str(error)}}


if __name__ == "__main__":
    print(json.dumps(handle(json.loads(sys.stdin.readline()))), flush=True)
