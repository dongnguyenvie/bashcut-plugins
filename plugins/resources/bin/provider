#!/bin/sh
# Starts Online Resources in its private environment (made by bin/setup: uv's Python with Pillow, NumPy, fontTools
# and resvg). Before setup it runs the Mac's python3 only to answer with a clear "install the dependency" error.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
data="${BASHCUT_PLUGIN_DATA:-$HOME/Library/Application Support/BashCut/PluginData/bashcut.resources}"
python="$data/venv/bin/python3"
[ -x "$python" ] || python="$(command -v python3)"
export PYTHONDONTWRITEBYTECODE=1
exec "$python" "$here/../src/main.py" "$@"
