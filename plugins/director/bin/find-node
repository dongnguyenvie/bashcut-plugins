#!/bin/sh
# Prints the path of a Node.js >= 22.19 for AI Editor, or exits 1. Shared by bin/check, bin/provider and bin/setup.
# Order: the copy bin/setup installs in the plugin data folder, Homebrew, /usr/local, nvm (newest first), Volta,
# then PATH. BashCut starts plugins with PATH=/usr/bin:/bin:/usr/sbin:/sbin (+ Homebrew), so nvm and Volta are
# looked up by folder.
data="${BASHCUT_PLUGIN_DATA:-$HOME/Library/Application Support/BashCut/PluginData/bashcut.director}"

# node_ok <path>: the file runs and reports v22.19 or newer.
node_ok() {
    [ -x "$1" ] || return 1
    version="$("$1" -v 2>/dev/null)" || return 1
    version="${version#v}"
    major="${version%%.*}"
    rest="${version#*.}"
    minor="${rest%%.*}"
    case "$major$minor" in *[!0-9]*|"") return 1 ;; esac
    [ "$major" -gt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 19 ]; }
}

candidates() {
    echo "$data/node/bin/node"
    echo "/opt/homebrew/bin/node"
    echo "/usr/local/bin/node"
    if [ -d "$HOME/.nvm/versions/node" ]; then
        # v24.1.0 sorts after v22.23.1 numerically; newest first.
        ls "$HOME/.nvm/versions/node" 2>/dev/null | sed 's/^v//' | sort -t. -k1,1nr -k2,2nr -k3,3nr |
            while read -r v; do echo "$HOME/.nvm/versions/node/v$v/bin/node"; done
    fi
    echo "$HOME/.volta/bin/node"
    command -v node 2>/dev/null || true
}

candidates | while read -r candidate; do
    if node_ok "$candidate"; then
        echo "$candidate"
        exit 3
    fi
done
# The loop runs in a subshell: its exit 3 means "found and printed".
[ $? -eq 3 ] && exit 0
exit 1
