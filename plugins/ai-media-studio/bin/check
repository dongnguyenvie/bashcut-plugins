#!/bin/sh
studio_data="${BASHCUT_PLUGIN_DATA:-$HOME/Library/Application Support/BashCut/PluginData/bashcut.ai-media-studio}"
exec "$studio_data/venv/bin/python3" -c 'import sys, numpy, PIL, requests, certifi, imageio_ffmpeg, subprocess; sys.exit(1) if sys.version_info[:2] != (3,12) else None; subprocess.run([imageio_ffmpeg.get_ffmpeg_exe(), "-version"], check=True, stdout=subprocess.DEVNULL)' 2>/dev/null
