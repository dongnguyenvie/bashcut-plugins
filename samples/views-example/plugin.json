{
  "schema": "bashcut.plugin/1",
  "id": "bashcut.views-example",
  "name": {
    "en": "Views Example",
    "vi": "Ví dụ giao diện"
  },
  "version": "0.0.3",
  "apiVersion": 11,
  "entrypoint": "bin/provider",
  "transport": "session",
  "category": "sample",
  "capabilities": [],
  "dependencies": [],
  "requires": [
    {
      "id": "bashcut.audio-analysis",
      "version": ">=1.0.0"
    }
  ],
  "uses": [
    "audio.loudness"
  ],
  "features": [
    "views"
  ],
  "options": [
    {
      "id": "greeting",
      "title": {
        "en": "Greeting",
        "vi": "Lời chào"
      },
      "type": "string",
      "default": "Xin chào"
    },
    {
      "id": "provider",
      "title": {
        "en": "Voice plugin",
        "vi": "Plugin giọng"
      },
      "help": {
        "en": "The voice.synthesize provider the Voice tab uses; empty lets BashCut choose. The tab saves it.",
        "vi": "Nhà cung cấp voice.synthesize mà tab Giọng nói dùng; để trống thì BashCut chọn. Tab tự lưu lựa chọn."
      },
      "type": "string",
      "default": ""
    }
  ],
  "contributes": {
    "container": {
      "icon": "square.grid.2x2",
      "title": {
        "en": "Views",
        "vi": "Giao diện"
      }
    },
    "views": [
      {
        "id": "gallery",
        "title": {
          "en": "Components",
          "vi": "Thành phần"
        }
      },
      {
        "id": "voice",
        "title": {
          "en": "Voice",
          "vi": "Giọng nói"
        },
        "location": "dock",
        "icon": "waveform"
      },
      {
        "id": "titleCard",
        "title": {
          "en": "Title card",
          "vi": "Thẻ tiêu đề"
        },
        "location": "sheet",
        "icon": "textformat"
      },
      {
        "id": "live",
        "title": {
          "en": "Live",
          "vi": "Trực tiếp"
        }
      },
      {
        "id": "browser",
        "title": {
          "en": "Browser",
          "vi": "Trình duyệt"
        },
        "location": "window",
        "icon": "square.split.3x1"
      }
    ],
    "actions": [
      {
        "id": "bashcut.views-example.hello",
        "title": {
          "en": "Say hello",
          "vi": "Chào"
        },
        "icon": "hand.wave",
        "placements": [
          "menu.plugins"
        ]
      },
      {
        "id": "bashcut.views-example.title-card",
        "title": {
          "en": "New title card…",
          "vi": "Thẻ tiêu đề mới…"
        },
        "icon": "textformat",
        "placements": [
          "menu.plugins"
        ]
      }
    ],
    "skills": [
      {
        "path": "skills/views-example"
      }
    ]
  },
  "minApiVersion": 11
}
