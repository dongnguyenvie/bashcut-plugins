#!/bin/sh
# Install recipe for VieNeu TTS. BashCut runs it after the user approves, in the plugin's own environment:
#   BASHCUT_PLUGIN_DATA  — kept across plugin updates: uv and the virtual environment
#   BASHCUT_PLUGIN_CACHE — can be downloaded again: the voice model
#   BASHCUT_SHARED_DATA  — shared with other Python plugins: uv's Python 3.12
#   BASHCUT_SHARED_CACHE — shared with other Python plugins: uv's package cache. The venv gets APFS clones of its
#                          files, so clearing it never breaks the venv, and this script never cleans it.
# Without the shared folders (an older BashCut), Python and the package cache stay in the plugin's own folders.
# It does not depend on the Mac's Python (macOS ships 3.9; VieNeu needs 3.10+). `::progress` lines drive the
# progress bar in BashCut. Running it again repairs or updates the install.
set -eu
data="${BASHCUT_PLUGIN_DATA:-$HOME/Library/Application Support/BashCut/PluginData/bashcut.vieneu-tts}"
cache="${BASHCUT_PLUGIN_CACHE:-$HOME/Library/Caches/BashCut/PluginData/bashcut.vieneu-tts}"
pythons="${BASHCUT_SHARED_DATA:+$BASHCUT_SHARED_DATA/python}"
packages="${BASHCUT_SHARED_CACHE:+$BASHCUT_SHARED_CACHE/uv}"
mkdir -p "$data/bin" "$cache"
export UV_CACHE_DIR="${packages:-$cache/uv}" UV_PYTHON_INSTALL_DIR="${pythons:-$data/python}" UV_NO_PROGRESS=1

echo "::progress 0.02 Preparing uv"
uv="$(command -v uv || true)"
if [ -z "$uv" ]; then
    uv="$data/bin/uv"
    if [ ! -x "$uv" ]; then
        case "$(uname -m)" in
            arm64) target="aarch64-apple-darwin" ;;
            *) target="x86_64-apple-darwin" ;;
        esac
        echo "Downloading uv for $target"
        tmp="$(mktemp -d)"
        curl --fail --location --silent --show-error \
            "https://github.com/astral-sh/uv/releases/latest/download/uv-$target.tar.gz" -o "$tmp/uv.tar.gz"
        tar -xzf "$tmp/uv.tar.gz" -C "$tmp"
        mv "$tmp/uv-$target/uv" "$uv"
        rm -rf "$tmp"
    fi
fi
"$uv" --version

echo "::progress 0.10 Installing Python 3.12"
python="$data/venv/bin/python3"
# Only a Python uv manages in UV_PYTHON_INSTALL_DIR: one the user installed may be removed later. A venv on the
# plugin's own Python from before the shared folders is made again on the shared one.
if [ ! -x "$python" ] || ! "$python" -c "import sys; sys.exit(sys.version_info < (3, 10) or not sys.base_prefix.startswith('$UV_PYTHON_INSTALL_DIR/'))" 2>/dev/null; then
    rm -rf "$data/venv"
    "$uv" venv --python 3.12 --python-preference only-managed "$data/venv"
fi
# The plugin's own Python and package cache are no longer used once the shared ones are.
if [ -n "$pythons" ]; then rm -rf "$data/python"; fi
if [ -n "$packages" ]; then rm -rf "$cache/uv"; fi

echo "::progress 0.30 Installing VieNeu (about 750 MB)"
# onnxruntime 1.23+ refuses the model's external data through Hugging Face's symlinked cache.
"$uv" pip install --python "$python" --upgrade "vieneu>=3.8,<4" "onnxruntime>=1.20,<1.23"

echo "::progress 0.70 Downloading the voice model (about 600 MB)"
# A model from an earlier layout (inside the data folder) moves to the cache instead of downloading again.
if [ -d "$data/huggingface" ] && [ ! -d "$cache/huggingface" ]; then mv "$data/huggingface" "$cache/huggingface"; fi
HF_HOME="$cache/huggingface" HF_HUB_DISABLE_PROGRESS_BARS=1 "$python" -c "from vieneu import Vieneu; Vieneu()"

# Without a shared cache, uv's package cache would only take space. A shared one is kept for other plugins.
if [ -z "$packages" ]; then
    echo "::progress 0.95 Cleaning up"
    "$uv" cache clean >/dev/null 2>&1 || true
fi
echo "::progress 1.0 VieNeu is ready"
